# Copy to .env for LOCAL runs only (never commit .env). In GitHub use repository secrets.
# Required
BLOG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# AI writers — all optional, all free tiers; the bot uses the first one that works
GEMINI_API_KEY=            # https://aistudio.google.com/api-keys  (new keys start with AQ.)
GROQ_API_KEY=              # https://console.groq.com/keys
OPENROUTER_API_KEY=        # https://openrouter.ai/settings/keys
CLOUDFLARE_ACCOUNT_ID=     # https://dash.cloudflare.com  (Workers AI)
CLOUDFLARE_API_TOKEN=
HF_TOKEN=                  # https://huggingface.co/settings/tokens

# Indexing — optional
INDEXING_SERVICE_ACCOUNT_JSON=
INDEXNOW_KEY=
BING_WEBMASTER_API_KEY=

# Notifications & social — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
